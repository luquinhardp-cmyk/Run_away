rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function checkpoint(c) {
      return c.keys().hasOnly(['version', 'items', 'power', 'doors', 'elapsed_ms', 'world'])
        && (c.version == 1 || (c.version == 2 && world(c.world)))
        && c.items is list && c.items.size() <= 4
        && c.items.hasOnly(['lanterna', 'fusivel', 'cartao', 'chave_oficina'])
        && c.power is bool && (!c.power || c.items.hasAll(['fusivel']))
        && c.doors is map && c.doors.size() <= 20
        && c.elapsed_ms is number && c.elapsed_ms >= 0 && c.elapsed_ms <= 604800000;
    }
    function world(w) {
      return w.keys().hasOnly(['seed', 'variant', 'difficulty', 'unlocks', 'events', 'fuse_installed', 'generator_started', 'blackout', 'throwables', 'collected_props', 'escaped', 'horror', 'physics'])
        && (!w.keys().hasAny(['horror']) || horror(w.horror))
        && (!w.keys().hasAny(['physics']) || physics(w.physics))
        && w.seed is number && w.seed >= 0 && w.seed <= 2147483647
        && w.variant in [0, 1] && w.difficulty in [0, 1, 2]
        && w.unlocks is map && w.unlocks.keys().hasOnly(['workshop'])
        && w.events is map && w.events.keys().hasOnly(['impact', 'pipe', 'blackout'])
        && w.fuse_installed is bool && w.generator_started is bool
        && w.blackout is bool && w.escaped is bool
        && w.throwables is number && w.throwables >= 0 && w.throwables <= 7
        && w.collected_props is list && w.collected_props.size() <= 7
        && w.collected_props.hasOnly(['metal_0','metal_1','metal_2','metal_3','metal_4','metal_5','metal_6']);
    }
    function optionalProp(p, id) {
      let state = p.get(id, null);
      return !p.keys().hasAny([id]) || (state.keys().hasOnly(['t','broken'])
        && state.t is string && state.t.matches('^-?([0-4]?[0-9](\\.[0-9]{1,2})?|50(\\.0{1,2})?),-?([0-4]?[0-9](\\.[0-9]{1,2})?|50(\\.0{1,2})?),-?([0-4]?[0-9](\\.[0-9]{1,2})?|50(\\.0{1,2})?);-?([0-2](\\.[0-9]{1,2})?|3(\\.(0[0-9]?|1[0-5]?))?),-?([0-2](\\.[0-9]{1,2})?|3(\\.(0[0-9]?|1[0-5]?))?),-?([0-2](\\.[0-9]{1,2})?|3(\\.(0[0-9]?|1[0-5]?))?)$') && state.broken is bool);
    }
    function physics(p) {
      return p is map && p.keys().hasOnly(['can', 'bottle_ward', 'tool_edge', 'small_crate', 'chair_maintenance', 'crate_storage', 'trolley_ward', 'bucket_power', 'rubber_gallery', 'fragile_workshop', 'bottle_shelf', 'drawer_tool', 'drawer'])
        && optionalProp(p, 'can')
        && optionalProp(p, 'bottle_ward')
        && optionalProp(p, 'tool_edge')
        && optionalProp(p, 'small_crate')
        && optionalProp(p, 'chair_maintenance')
        && optionalProp(p, 'crate_storage')
        && optionalProp(p, 'trolley_ward')
        && optionalProp(p, 'bucket_power')
        && optionalProp(p, 'rubber_gallery')
        && optionalProp(p, 'fragile_workshop')
        && optionalProp(p, 'bottle_shelf')
        && optionalProp(p, 'drawer_tool')
        && (!p.keys().hasAny(['drawer']) || (p.drawer.keys().hasOnly(['open']) && p.drawer.open is bool));
    }
    function horror(h) {
      return h.keys().hasOnly(['counts','history','cooldown_remaining','rng_state'])
        && h.counts is map && h.counts.size() <= 9
        && h.history is list && h.history.size() <= 6
        && h.cooldown_remaining is number && h.cooldown_remaining >= 0 && h.cooldown_remaining <= 120
        && h.rng_state is string && h.rng_state.size() <= 32;
    }
    function validRun(r, id) {
      return id.matches('^[a-f0-9]{32}$') && r.id == id
        && r.keys().hasOnly(['id', 'won', 'elapsed_ms', 'score', 'items', 'power'])
        && r.won is bool && r.power is bool
        && r.elapsed_ms is number && r.elapsed_ms >= 0 && r.elapsed_ms <= 604800000
        && r.items is list && r.items.size() <= 4 && r.items.toSet().size() == r.items.size()
        && r.items.hasOnly(['lanterna', 'fusivel', 'cartao', 'chave_oficina'])
        && (!r.power || r.items.hasAll(['fusivel']))
        && (!r.won || (r.power && r.items.hasAll(['fusivel', 'cartao'])))
        && r.score == (r.items.hasAny(['lanterna']) ? 100 : 0)
          + (r.items.hasAny(['fusivel']) ? 100 : 0) + (r.items.hasAny(['cartao']) ? 100 : 0)
          + (r.power ? 300 : 0) + (r.won ? 500 : 0);
    }
    function totals(uid) {
      let before = resource.data.stats;
      let after = request.resource.data.stats;
      let id = request.resource.data.lastRunId;
      let path = /databases/$(database)/documents/players/$(uid)/runs/$(id);
      let r = getAfter(path).data;
      return !exists(path) && validRun(r, id)
        && after.keys().hasOnly(['totalPoints', 'runs', 'escapes', 'bestEscapeMs'])
        && after.totalPoints == before.totalPoints + r.score
        && after.runs == before.runs + 1
        && after.escapes == before.escapes + (r.won ? 1 : 0)
        && after.bestEscapeMs == (r.won && r.elapsed_ms < before.bestEscapeMs ? r.elapsed_ms : before.bestEscapeMs);
    }
    match /players/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'stats'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.stats == {'totalPoints': 0, 'runs': 0, 'escapes': 0, 'bestEscapeMs': 604800001};
      allow update: if owner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkpoint'])
          && checkpoint(request.resource.data.checkpoint))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'lastRunId']) && totals(uid))
      );
      match /runs/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validRun(request.resource.data, id)
          && getAfter(/databases/$(database)/documents/players/$(uid)).data.lastRunId == id
          && getAfter(/databases/$(database)/documents/players/$(uid)).data.stats.runs
             == get(/databases/$(database)/documents/players/$(uid)).data.stats.runs + 1;
      }
    }
  }
}
